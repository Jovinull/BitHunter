{
  // Telemetria do plugin da RedHat
  "redhat.telemetry.enabled": true,
  // Git
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  // Projeto Java
  "java.project.sourcePaths": [
    "src",
    "resource"
  ],
  "java.configuration.updateBuildConfiguration": "automatic",
  "extensions.ignoreRecommendations": false,
  // Ações ao salvar
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "java.saveActions.organizeImports": true,
  // Indentação padronizada no projeto
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  // Arquivos (higiene multiplataforma)
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // Escopo só para Java (evita forçar formatter em outras linguagens)
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  // Checkstyle
  "java.checkstyle.properties": {},
  "java.checkstyle.modules": [],
  "java.format.settings.url": "/.vscode/eclipse-formatter.xml",
  // Compilação — habilitar warnings do javac via Language Server
  "java.compile.nullAnalysis.mode": "automatic",
  "java.settings.url": "",
  // SonarLint — modo standalone (sem servidor)
  // Para conectar a um SonarQube/SonarCloud, veja:
  //   https://docs.sonarsource.com/sonarlint/vs-code/team-features/connected-mode/
  // Configurar connected mode nas settings do USUÁRIO (não do workspace):
  //   "sonarlint.connectedMode.connections.sonarqube": [
  //     { "serverUrl": "https://SEU-SONARQUBE", "token": "<token-pessoal>" }
  //   ]
  //   "sonarlint.connectedMode.project": {
  //     "connectionId": "<id>",
  //     "projectKey": "BitHunter"
  //   }
  "sonarlint.output.showAnalyzerLogs": true,
  "sonarlint.output.showVerboseLogs": false,
  "sonarlint.pathToNodeExecutable": ""
}
